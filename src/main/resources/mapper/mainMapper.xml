<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ysedu.practice.Mapper.MainMapper">
    <insert id="insertItem" parameterType="ysedu.practice.Dto.FruitDto">
insert into items(name) values(#{name});
    </insert>

    <select id="selectItemById" resultType="ysedu.practice.Dto.FruitDto">
        select * from items where id = #{id}
    </select>

    <select id="selectItems" resultType="ysedu.practice.Dto.FruitDto">
<!--        select * from items order by id;-->
        select id, name from items order by id limit #{limit} offset #{offset}
    </select>

    <delete id="deleteItem">
        delete from items where id=#{id}
    </delete>

    <update id="updateItem" parameterType="ysedu.practice.Dto.FruitDto">
        update items set name = #{name} where id = #{id};
    </update>

    <select id="countTotal" resultType="Integer">
        select count(*) from items;
    </select>

</mapper>